docker pull ghcr.io/eclipse/kuksa.val/databroker:latest

# Run it — VSS4 mode, port 55555 (matching your KuksaHandler connect_v2 call)
NOT  NOT docker run -d \
    --name kuksa-databroker \
    --restart unless-stopped \
    -p 55555:55555 \
    ghcr.io/eclipse/kuksa.val/databroker:latest \
    --port 55555 \
    --insecure
    
