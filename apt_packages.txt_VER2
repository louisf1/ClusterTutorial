# Build tools
sudo apt install build-essential cmake ninja-build pkg-config

# OpenGL (build-time)
sudo apt install libgl1-mesa-dev libegl1-mesa-dev libglu1-mesa-dev

# Wayland (build-time)
sudo apt install libwayland-dev libwayland-egl-backend-dev wayland-protocols

# XKB (build-time, needed for Qt6::GuiPrivate)
sudo apt install libxkbcommon-dev libxkbcommon-x11-dev

# Vulkan headers (build-time)
sudo apt install libvulkan-dev

# XCB cursor (runtime, needed for xcb platform plugin)
sudo apt install libxcb-cursor0
